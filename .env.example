# Supabase — pegue em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Supabase — service_role key, na mesma tela (Project Settings > API).
# Opcional: só é usada para excluir a própria conta (Perfil > Zona de risco).
# NUNCA prefixe com NEXT_PUBLIC_ — esta chave ignora o RLS e não pode chegar
# ao navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — para a análise com IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
